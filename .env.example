# ---------------------------------------------------------------------------
# Veltrix Bank — environment variable template
# Copy to .env and replace placeholders. NEVER commit real secrets.
# Local WAMP MySQL is used for this simulated banking application.
# ---------------------------------------------------------------------------

# Server-only: MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://veltrix_app:change-me@127.0.0.1:3306/veltrix_bank"

# Server-only: separate database used by Prisma Migrate to diff schemas.
# Prisma needs write access to this database, but it holds no application data.
SHADOW_DATABASE_URL="mysql://veltrix_app:change-me@127.0.0.1:3306/veltrix_shadow"

# Server-only: Node environment.
NODE_ENV="development"

# Optional server-only log level: debug | info | warn | error
LOG_LEVEL="info"

# Public (safe to expose to the browser): canonical application URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public (safe to expose to the browser): display name.
NEXT_PUBLIC_APP_NAME="Veltrix Bank"

# ---------------------------------------------------------------------------
# Phase 004 — Email delivery (optional; required for real verification/reset emails)
# If SMTP is not fully configured, the app must not pretend an email was sent.
# In development, check server logs for safe delivery status (never token values in production).
# ---------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="change-me"
# SMTP_FROM="Veltrix Bank <no-reply@example.com>"

# Optional: base URL for auth links (defaults to NEXT_PUBLIC_APP_URL)
# APP_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Initial administrator bootstrap (CLI only; never used by public routes/UI)
# Set temporarily, run the bootstrap command, then remove or rotate values.
# ---------------------------------------------------------------------------
# ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="Use-A-Strong-Password-Here!"
# ADMIN_BOOTSTRAP_FIRST_NAME="Veltrix"
# ADMIN_BOOTSTRAP_LAST_NAME="Administrator"
# ADMIN_BOOTSTRAP_ROLE="SUPER_ADMIN" # or ADMIN
